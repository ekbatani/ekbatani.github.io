---
import type { Project } from '../lib/profile.mjs';

const { projects } = Astro.props as { projects: Project[] };
---
<ul class="stack-list">
  {projects.map((p) => {
    const href = p.url || p.repo;
    return (
      <li>
        <h3>{href ? <a href={href}>{p.name}</a> : p.name}</h3>
        <p>{p.summary}</p>
        <p class="tags">
          {p.stack.join(' · ')}
          {p.url && p.repo && <> · <a href={p.repo}>source</a></>}
        </p>
      </li>
    );
  })}
</ul>
